---
import BaseLayout from "../layouts/BaseLayout.astro";
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Profiling Figures" description="Durations and speedup plots plus case metadata explorer.">
  <section class="hero">
    <p id="figures-breadcrumb" class="muted" style="margin-top: 0;"></p>
    <h1>Profiling figures</h1>
    <p>Compare every run in this case, then explore individual runs and metadata below.</p>
  </section>

  <section id="case-analysis" class="analysis-viewer" aria-label="Case analysis"></section>

  <section class="card" id="case-gallery-section" style="margin-top: 1rem; display: none;">
    <h2 style="margin-top: 0;">Gallery <span class="muted" id="case-gallery-subtitle"></span></h2>
    <div id="case-gallery" class="gallery-grid"></div>
  </section>

  <section id="cases" class="card" style="margin-top: 1rem;">
    <h2>Case metadata explorer</h2>
    <p class="muted">Select a run to inspect its timing statistics across all recorded ranks. The shared filters above also apply to this table.</p>
    <div id="case-meta-panel" class="card" style="margin-bottom: 1rem;"></div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Run label</th>
            <th>Ranks</th>
            <th>Regions</th>
            <th>Open</th>
          </tr>
        </thead>
        <tbody id="cases-table-body"></tbody>
      </table>
    </div>
    <div id="case-panel" class="card" style="margin-top: 1rem;"></div>
  </section>

  <section class="card" id="case-parameters-section" style="margin-top: 1rem; display: none;">
    <h2 style="margin-top: 0;">Parameter file</h2>
    <p class="muted" id="case-parameters-path" style="margin-top: 0;"></p>
    <pre class="code-block"><code id="case-parameters-code" class="language-python"></code></pre>
  </section>
</BaseLayout>

<script>
  import Prism from "prismjs";
  import "prismjs/components/prism-python";
  import { AnalysisViewer, renderStatisticsTable } from "../lib/analysis.js";
  import { groupKeyForCase } from "../lib/cases.js";
  import { renderGallery } from "../lib/gallery.js";

  const rawBaseUrl = import.meta.env.BASE_URL;
  const baseUrl = rawBaseUrl.endsWith("/") ? rawBaseUrl : `${rawBaseUrl}/`;
  const casesTableBody = document.getElementById("cases-table-body");
  const casePanel = document.getElementById("case-panel");
  const caseMetaPanel = document.getElementById("case-meta-panel");
  const figuresBreadcrumb = document.getElementById("figures-breadcrumb");
  let activeFile = null;
  let selection = null;
  const analysis = new AnalysisViewer(document.getElementById("case-analysis"), baseUrl, (next) => {
    selection = next;
    if (activeFile) renderCase(activeFile);
  });
  const caseGallerySection = document.getElementById("case-gallery-section");
  const caseGallerySubtitle = document.getElementById("case-gallery-subtitle");
  const caseGallery = document.getElementById("case-gallery");
  const caseParametersSection = document.getElementById("case-parameters-section");
  const caseParametersPath = document.getElementById("case-parameters-path");
  const caseParametersCode = document.getElementById("case-parameters-code");

  const fmt = (value) => {
    if (typeof value !== "number" || Number.isNaN(value)) return "-";
    if (Math.abs(value) >= 1) return value.toFixed(4);
    return value.toExponential(3);
  };

  const esc = (value) =>
    String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");

  const fmtValue = (value) => {
    if (value === null || value === undefined || value === "") return "-";
    if (typeof value === "object") return esc(JSON.stringify(value));
    return esc(String(value));
  };

  const formatDatetime = (value) => {
    const text = String(value ?? "");
    if (!text) return "-";
    const parsed = new Date(text);
    if (Number.isNaN(parsed.getTime())) return text;
    return parsed.toLocaleString();
  };

  const renderCase = (entry) => {
    activeFile = entry;
    const file = selection?.files.find((file) => file.label === entry.label) ?? entry;
    casePanel.innerHTML = `
      <h3 style="margin-top:0;">${esc(entry.label ?? "Unnamed run")}</h3>
      <p class="muted"><strong>Ranks:</strong> ${entry.num_ranks ?? "—"} · All recorded ranks</p>
      <div class="table-wrap"><table><thead><tr><th>Region</th><th>Count</th><th>Avg (s)</th><th>Min (s)</th><th>Max (s)</th><th>Total (s)</th></tr></thead><tbody></tbody></table></div>`;
    if (selection) renderStatisticsTable(casePanel.querySelector("tbody"), file, selection);
  };

  const renderCaseGallery = (selectedCase) => {
    const rendered = renderGallery(caseGallery, selectedCase?.gallery, baseUrl);
    caseGallerySection.style.display = rendered ? "" : "none";
    caseGallerySubtitle.textContent = rendered ? "(first run)" : "";
  };

  const renderCaseParameters = async (selectedCase) => {
    const path = selectedCase?.parameters_file;
    if (!path) {
      caseParametersSection.style.display = "none";
      caseParametersCode.textContent = "";
      return;
    }
    caseParametersSection.style.display = "";
    caseParametersPath.textContent = path;
    caseParametersCode.textContent = "Loading…";
    try {
      const res = await fetch(`${baseUrl}figures/${path}`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const source = await res.text();
      caseParametersCode.textContent = source;
      Prism.highlightElement(caseParametersCode);
    } catch (error) {
      caseParametersCode.textContent = `Could not load parameter file: ${error}`;
    }
  };

  const renderCaseMetadata = (selectedCase) => {
    const metadata = selectedCase?.case_metadata ?? {};
    caseMetaPanel.innerHTML = `
      <h3 style="margin-top:0;">${esc(selectedCase?.title ?? "Case metadata")}</h3>
      <div class="metadata-grid">
        <div><strong>Datetime:</strong> ${esc(formatDatetime(selectedCase?.datetime_utc ?? metadata.datetime_utc))}</div>
        <div><strong>Model:</strong> ${fmtValue(selectedCase?.struphy_model_used ?? metadata.struphy_model_used)}</div>
        <div><strong>Physics problem:</strong> ${fmtValue(selectedCase?.physics_problem ?? metadata.physics_problem)}</div>
        <div><strong>Cluster:</strong> ${fmtValue(selectedCase?.cluster_name ?? metadata.cluster_name)}</div>
        <div><strong>Test case:</strong> ${fmtValue(metadata.test_case_identifier || metadata.testcase)}</div>
        <div><strong>Language:</strong> ${fmtValue(metadata.language)}</div>
        <div><strong>Commit:</strong> ${fmtValue(metadata.commit_short || metadata.commit)}</div>
        <div><strong>Pyccel:</strong> ${fmtValue(
          [metadata.pyccel_language, metadata.pyccel_compiler_family].filter(Boolean).join(" / "),
        )}</div>
      </div>
      <p class="muted" style="white-space: pre-wrap; margin-bottom: 0;">
        ${esc(selectedCase?.description ?? metadata.test_case_description ?? "")}
      </p>
    `;
  };

  const render = async () => {
    try {
      const requestedCase = new URLSearchParams(window.location.search).get("case");
      const res = await fetch(`${baseUrl}figures/region_statistics.json`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      const allFiles = Array.isArray(data.files) ? data.files.slice() : [];
      const cases = Array.isArray(data.cases) ? data.cases.slice() : [];

      if (!allFiles.length || !cases.length) {
        casePanel.innerHTML = "<p class='muted'>No cases found in region_statistics.json.</p>";
        return;
      }

      const selectedCase =
        cases.find((entry) => entry.id === requestedCase) ??
        cases.find((entry) =>
          allFiles.some((file) => file.case_id === entry.id && file.label === requestedCase),
        ) ??
        cases[0];

      figuresBreadcrumb.innerHTML = `
        <a href="${baseUrl}">Case overview</a>
        &rsaquo;
        <a href="${baseUrl}instances?group=${encodeURIComponent(groupKeyForCase(selectedCase))}">
          ${selectedCase.title ? `${selectedCase.title} instances` : "Instances"}
        </a>
      `;

      const files = allFiles
        .filter((entry) => entry.case_id === selectedCase.id)
        .sort((a, b) => (a.num_ranks ?? Number.MAX_SAFE_INTEGER) - (b.num_ranks ?? Number.MAX_SAFE_INTEGER));
      const commonRegions = Array.isArray(selectedCase.common_regions)
        ? selectedCase.common_regions
        : [];

      if (!files.length) {
        casePanel.innerHTML = "<p class='muted'>No runs found for the selected case.</p>";
        await analysis.load(selectedCase.analysis);
        renderCaseMetadata(selectedCase);
        renderCaseGallery(selectedCase);
        renderCaseParameters(selectedCase);
        return;
      }

      const selectedIndex = Math.max(
        0,
        files.findIndex((entry) => entry.label === requestedCase),
      );

      await analysis.load(selectedCase.analysis);
      renderCaseMetadata(selectedCase);
      renderCaseGallery(selectedCase);
      renderCaseParameters(selectedCase);
      let activeRow = null;
      files.forEach((entry, index) => {
        const row = document.createElement("tr");
        row.className = `case-row${index === selectedIndex ? " active" : ""}`;
        row.tabIndex = 0;
        row.innerHTML = `
          <td><strong>${esc(entry.label ?? "Unnamed run")}</strong></td>
          <td>${entry.num_ranks ?? "-"}</td>
          <td>${Object.keys(entry.region_statistics || {}).length}</td>
          <td><a href="${baseUrl}run?case=${encodeURIComponent(selectedCase.id)}&run=${encodeURIComponent(entry.label ?? "")}">Run details</a></td>
        `;

        const select = () => {
          if (activeRow) activeRow.classList.remove("active");
          row.classList.add("active");
          activeRow = row;
          renderCase(entry);
        };

        row.addEventListener("click", select);
        row.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            select();
          }
        });

        casesTableBody.appendChild(row);
      });

      renderCase(files[selectedIndex]);
      activeRow = casesTableBody.querySelector(".case-row.active");
    } catch (error) {
      casePanel.innerHTML = `<p class='muted'>Could not load metadata: ${esc(error)}</p>`;
      analysis.setError(error);
    }
  };

  render();
</script>
