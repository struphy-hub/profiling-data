---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Struphy Profiling Dashboard" description="Professional overview of profiling cases and generated plots.">
  <section class="hero">
    <h1>Struphy profiling dashboard</h1>
    <p>
      Overview of available profiling cases. Open a case to see every instance it has been run (one per submission),
      then drill into an instance to inspect its runs, metadata, and generated durations/speedup plots.
    </p>
  </section>

  <section class="card" style="margin-top: 1rem;">
    <h2>Cases</h2>
    <div class="toolbar">
      <input
        id="cases-search"
        class="search-input"
        type="search"
        placeholder="Search case titles, physics problem, or model…"
        aria-label="Search cases"
        autocomplete="off"
      />
      <span id="cases-result-count" class="result-count"></span>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Latest run</th>
            <th>Case title</th>
            <th>Physics problem</th>
            <th>Struphy model used</th>
            <th>Instances</th>
            <th>Open</th>
            <th>Compare</th>
          </tr>
        </thead>
        <tbody id="home-cases-table-body"></tbody>
      </table>
    </div>
  </section>
</BaseLayout>

<script>
  import { groupCases, groupKeyForCase, groupLabelForCase } from "../lib/cases.js";

  const rawBaseUrl = import.meta.env.BASE_URL;
  const baseUrl = rawBaseUrl.endsWith("/") ? rawBaseUrl : `${rawBaseUrl}/`;
  const tableBody = document.getElementById("home-cases-table-body");

  const esc = (value) =>
    String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");

  const formatDatetime = (value) => {
    const text = String(value ?? "");
    if (!text) return "-";
    const parsed = new Date(text);
    if (Number.isNaN(parsed.getTime())) return text;
    return parsed.toLocaleString();
  };

  // Joins the distinct, non-empty values for a field across all instances of
  // a case, since e.g. the struphy model or physics problem is expected to
  // be constant per case but is technically stored per instance.
  const distinctValues = (entries, getter) => {
    const values = [];
    for (const entry of entries) {
      const value = String(getter(entry) ?? "").trim();
      if (value && !values.includes(value)) values.push(value);
    }
    return values;
  };

  const render = async () => {
    try {
      const res = await fetch(`${baseUrl}figures/region_statistics.json`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      const cases = Array.isArray(data.cases) ? data.cases.slice() : [];
      if (!cases.length) {
        tableBody.innerHTML = '<tr><td colspan="7" class="muted">No cases found in region_statistics.json.</td></tr>';
        return;
      }

      const groups = [...groupCases(cases).entries()].map(([groupKey, entries]) => {
        const sorted = entries
          .slice()
          .sort((a, b) => String(b.datetime_utc ?? "").localeCompare(String(a.datetime_utc ?? "")));
        return { groupKey, entries: sorted, latest: sorted[0] };
      });
      groups.sort((a, b) => String(b.latest?.datetime_utc ?? "").localeCompare(String(a.latest?.datetime_utc ?? "")));

      tableBody.innerHTML = groups
        .map(({ groupKey, entries, latest }) => {
          // The description is no longer a column, but still feeds the filter
          // so searching for words from it finds the case.
          const description = String(latest?.description ?? "");
          const physicsProblems = distinctValues(entries, (entry) => entry.physics_problem);
          const models = distinctValues(entries, (entry) => entry.struphy_model_used);
          const searchText = [
            groupLabelForCase(latest),
            description,
            physicsProblems.join(" "),
            models.join(" "),
          ]
            .join(" ")
            .toLowerCase();
          const modelTags = models.length
            ? models.map((model) => `<span class="tag">${esc(model)}</span>`).join("")
            : "-";
          return `
            <tr data-search="${esc(searchText)}">
              <td>${esc(formatDatetime(latest?.datetime_utc))}</td>
              <td><strong>${esc(groupLabelForCase(latest))}</strong></td>
              <td>${esc(physicsProblems.join(", ") || "-")}</td>
              <td>${modelTags}</td>
              <td>${entries.length}</td>
              <td><a href="${baseUrl}instances?group=${encodeURIComponent(groupKey)}">View instances</a></td>
              <td><a href="${baseUrl}compare?a=${encodeURIComponent(latest?.id ?? "")}">Compare</a></td>
            </tr>
          `;
        })
        .join("");
      setupSearch(groups.length);
    } catch (error) {
      tableBody.innerHTML = `<tr><td colspan="7" class="muted">Could not load case table: ${esc(error)}</td></tr>`;
    }
  };

  const setupSearch = (totalCount) => {
    const searchInput = document.getElementById("cases-search");
    const resultCount = document.getElementById("cases-result-count");
    if (!searchInput || !resultCount) return;

    const rows = [...tableBody.querySelectorAll("tr[data-search]")];

    const applyFilter = () => {
      const query = searchInput.value.trim().toLowerCase();
      // Space-separated words all have to match, in any order, so "cyclone
      // cupy" finds the case whose title contains both.
      const terms = query.split(/\s+/).filter(Boolean);
      let visible = 0;
      for (const row of rows) {
        const haystack = row.dataset.search ?? "";
        const match = terms.every((term) => haystack.includes(term));
        row.style.display = match ? "" : "none";
        if (match) visible += 1;
      }

      // Show/remove a "no matches" placeholder row.
      let emptyRow = tableBody.querySelector("tr.empty-row");
      if (visible === 0) {
        if (!emptyRow) {
          emptyRow = document.createElement("tr");
          emptyRow.className = "empty-row";
          emptyRow.innerHTML = '<td colspan="7" class="empty-state">No cases match your filter.</td>';
          tableBody.appendChild(emptyRow);
        }
      } else if (emptyRow) {
        emptyRow.remove();
      }

      resultCount.textContent = query
        ? `${visible} of ${totalCount} cases`
        : `${totalCount} case${totalCount === 1 ? "" : "s"}`;
    };

    searchInput.addEventListener("input", applyFilter);
    applyFilter();
  };

  render();
</script>
