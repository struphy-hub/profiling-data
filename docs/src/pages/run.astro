---
import BaseLayout from "../layouts/BaseLayout.astro";
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Run metadata" description="Detailed metadata and timings for an individual profiling run.">
  <section class="hero">
    <p id="run-breadcrumb" class="muted" style="margin-top: 0;"></p>
    <h1 id="run-title">Run</h1>
    <p class="muted">Figures, metadata and timings for a single profiling run.</p>
  </section>

  <section class="card">
    <div id="run-figures" class="grid"></div>
  </section>

  <section class="card" style="margin-top: 1rem;">
    <h2 style="margin-top: 0;">Run metadata</h2>
    <div id="run-meta-panel"></div>
  </section>

  <section class="card" id="run-parameters-section" style="margin-top: 1rem; display: none;">
    <h2 style="margin-top: 0;">Simulation parameters</h2>
    <div class="table-wrap">
      <table>
        <tbody id="run-parameters-body"></tbody>
      </table>
    </div>
  </section>

  <section class="card" id="run-gallery-section" style="margin-top: 1rem; display: none;">
    <h2 style="margin-top: 0;">Gallery</h2>
    <div id="run-gallery" class="gallery-grid"></div>
  </section>

  <section class="card" style="margin-top: 1rem;">
    <div class="figure-tile-header">
      <h2 style="margin-top: 0;">Flame graph <span class="muted">(rank 0)</span></h2>
      <a id="flamegraph-download" class="rank-btn" download hidden>Download .prof</a>
    </div>
    <div id="flamegraph-panel"></div>
  </section>

  <section class="card" style="margin-top: 1rem;">
    <div class="figure-tile-header">
      <h2 style="margin-top: 0;">Timeline <span class="muted">(rank 0)</span></h2>
      <div class="figure-tile-header">
        <a id="speedscope-open" class="rank-btn" target="_blank" rel="noopener" hidden>Open full page</a>
        <a id="speedscope-download" class="rank-btn" download hidden>Download profile</a>
      </div>
    </div>
    <p class="muted" style="margin-top: 0;">
      Every individual call, as it happened. Use the view selector for
      Time&nbsp;Order, Left&nbsp;Heavy or Sandwich.
    </p>
    <div id="speedscope-panel"></div>
  </section>

  <section class="card" style="margin-top: 1rem;">
    <h2 style="margin-top: 0;">Region statistics</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Region</th>
            <th>Count</th>
            <th>Avg (s)</th>
            <th>Min (s)</th>
            <th>Max (s)</th>
            <th>Total (s)</th>
          </tr>
        </thead>
        <tbody id="run-regions-body"></tbody>
      </table>
    </div>
  </section>
</BaseLayout>

<script>
  import Plotly from "plotly.js-dist-min";
  import { renderFigure, DEFAULT_REGION_FILTER } from "../lib/charts.js";
  import { groupKeyForCase } from "../lib/cases.js";
  import { renderGallery } from "../lib/gallery.js";

  const rawBaseUrl = import.meta.env.BASE_URL;
  const baseUrl = rawBaseUrl.endsWith("/") ? rawBaseUrl : `${rawBaseUrl}/`;
  const runMetaPanel = document.getElementById("run-meta-panel");
  const runTitle = document.getElementById("run-title");
  const runRegionsBody = document.getElementById("run-regions-body");
  const runBreadcrumb = document.getElementById("run-breadcrumb");
  const runFigures = document.getElementById("run-figures");
  const runGallerySection = document.getElementById("run-gallery-section");
  const runGallery = document.getElementById("run-gallery");
  const runParametersSection = document.getElementById("run-parameters-section");
  const runParametersBody = document.getElementById("run-parameters-body");
  const flamegraphPanel = document.getElementById("flamegraph-panel");
  const flamegraphDownload = document.getElementById("flamegraph-download");
  const speedscopePanel = document.getElementById("speedscope-panel");
  const speedscopeOpen = document.getElementById("speedscope-open");
  const speedscopeDownload = document.getElementById("speedscope-download");

  const esc = (value) =>
    String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");

  const fmt = (value) => {
    if (typeof value !== "number" || Number.isNaN(value)) return "-";
    if (Math.abs(value) >= 1) return value.toFixed(4);
    return value.toExponential(3);
  };

  const formatDatetime = (value) => {
    const text = String(value ?? "");
    if (!text) return "-";
    const parsed = new Date(text);
    if (Number.isNaN(parsed.getTime())) return text;
    return parsed.toLocaleString();
  };

  const metadataRows = (runEntry, selectedCase) => {
    const fileMetadata = runEntry.file_metadata || {};
    const caseMeta = selectedCase.case_metadata || {};
    const pragmas = runEntry.job_info?.pragmas || {};
    const rows = [
      ["Case", selectedCase.title ?? "-"],
      ["Run label", runEntry.label ?? "-"],
      ["Datetime", formatDatetime(selectedCase.datetime_utc ?? caseMeta.datetime_utc)],
      ["Ranks", runEntry.num_ranks ?? "-"],
      ["Model", selectedCase.struphy_model_used ?? caseMeta.struphy_model_used ?? "-"],
      ["Physics problem", selectedCase.physics_problem ?? caseMeta.physics_problem ?? "-"],
      ["Cluster name", selectedCase.cluster_name ?? caseMeta.cluster_name ?? "-"],
    ];
    if (pragmas.partition) rows.push(["Slurm partition", pragmas.partition]);
    if (pragmas.nodes != null) rows.push(["Nodes", pragmas.nodes]);
    if (pragmas.ntasks_per_node != null) rows.push(["Tasks per node", pragmas.ntasks_per_node]);
    if (pragmas.cpus_per_task != null) rows.push(["CPUs per task", pragmas.cpus_per_task]);
    if (pragmas.nodes != null && pragmas.ntasks_per_node != null && pragmas.cpus_per_task != null) {
      rows.push(["Total cores", pragmas.nodes * pragmas.ntasks_per_node * pragmas.cpus_per_task]);
    }
    if (pragmas.time) rows.push(["Time limit", pragmas.time]);
    if (pragmas.mem) rows.push(["Memory", pragmas.mem]);
    rows.push(
      ["Source file", runEntry.file_path ?? "-"],
      ["Case-relative path", fileMetadata.relative_source ?? "-"],
      ["Source run directory", fileMetadata.run_directory ?? "-"],
      ["Run parameters file", fileMetadata.run_metadata_destination ?? "-"],
    );
    return rows;
  };

  // The parameter JSON differs by model (Poisson vs. diocotron, ...), so
  // rather than hardcoding fields it renders every top-level key generically.
  // Nested objects/arrays (domain, grid, derham_opts, time_opts, ...) are
  // flattened to one compact "key: value, key: value" line instead of a
  // pretty-printed JSON blob - short enough to scan at a glance.
  const IGNORED_PARAMETER_KEYS = new Set(["env", "started_at_epoch_s"]);

  const compactValue = (value) => {
    if (value === null || value === undefined) return "-";
    if (Array.isArray(value)) {
      if (!value.length) return "[]";
      return `[${value.map(compactValue).join(", ")}]`;
    }
    if (typeof value === "object") {
      const entries = Object.entries(value);
      if (!entries.length) return "-";
      return `{${entries.map(([key, val]) => `${key}: ${compactValue(val)}`).join(", ")}}`;
    }
    return String(value);
  };

  const parameterRows = (runParameters) => {
    if (!runParameters || typeof runParameters !== "object") return [];
    return Object.entries(runParameters)
      .filter(([key]) => !IGNORED_PARAMETER_KEYS.has(key))
      .map(([key, value]) => [key, `<code class="parameter-value">${esc(compactValue(value))}</code>`]);
  };

  // Shows the rank 0 flameprof SVG. The SVG is inlined rather than used as an
  // <img> src so its per-frame <title> tooltips work.
  const setupFlamegraph = async (runEntry) => {
    const outputs = runEntry.run_outputs || {};
    if (!outputs.flamegraph) {
      flamegraphPanel.innerHTML = "<p class='muted'>No flame graph available for this run.</p>";
      return;
    }

    if (outputs.profile) {
      flamegraphDownload.href = `${baseUrl}figures/${outputs.profile}`;
      flamegraphDownload.hidden = false;
    }

    try {
      const res = await fetch(`${baseUrl}figures/${outputs.flamegraph}`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      flamegraphPanel.innerHTML = `<div class="flamegraph">${await res.text()}</div>`;
    } catch (error) {
      flamegraphPanel.innerHTML = `<p class="muted">Could not load flame graph: ${esc(error)}</p>`;
    }
  };

  // speedscope is a self-contained static app; it loads a profile from the
  // `profileURL` hash parameter. Embedded in an iframe because it owns its
  // whole document (keyboard shortcuts, its own layout and theming).
  const setupSpeedscope = (runEntry) => {
    const profile = runEntry.run_outputs?.speedscope;
    if (!profile) {
      speedscopePanel.innerHTML = "<p class='muted'>No timeline profile available for this run.</p>";
      return;
    }

    const profileUrl = new URL(`${baseUrl}figures/${profile}`, window.location.href).href;
    const title = runEntry.label ? `${runEntry.label} (rank 0)` : "rank 0";
    // index.html is named explicitly: the Astro dev server serves files from
    // public/ but does not resolve a bare directory to its index.
    const viewerUrl =
      `${baseUrl}speedscope/index.html#profileURL=${encodeURIComponent(profileUrl)}` +
      `&title=${encodeURIComponent(title)}`;

    speedscopeOpen.href = viewerUrl;
    speedscopeOpen.hidden = false;
    speedscopeDownload.href = profileUrl;
    speedscopeDownload.hidden = false;
    speedscopePanel.innerHTML = `<iframe class="speedscope-frame" src="${esc(viewerUrl)}" title="speedscope timeline"></iframe>`;
  };

  const setupGallery = (runEntry) => {
    const rendered = renderGallery(runGallery, runEntry.run_outputs?.gallery, baseUrl);
    runGallerySection.style.display = rendered ? "" : "none";
  };

  const setupParameters = (runEntry) => {
    const rows = parameterRows(runEntry.run_parameters);
    if (!rows.length) {
      runParametersSection.style.display = "none";
      runParametersBody.innerHTML = "";
      return;
    }
    runParametersBody.innerHTML = rows
      .map(([key, value]) => `<tr><th>${esc(key)}</th><td style="white-space: pre-wrap;">${value}</td></tr>`)
      .join("");
    runParametersSection.style.display = "";
  };

  const render = async () => {
    try {
      const params = new URLSearchParams(window.location.search);
      const requestedCase = params.get("case");
      const requestedRun = params.get("run");
      const res = await fetch(`${baseUrl}figures/region_statistics.json`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      const cases = Array.isArray(data.cases) ? data.cases.slice() : [];
      const files = Array.isArray(data.files) ? data.files.slice() : [];
      if (!cases.length || !files.length) throw new Error("No case/run data found");

      const selectedCase = cases.find((entry) => entry.id === requestedCase) ?? cases[0];
      const caseRuns = files
        .filter((entry) => entry.case_id === selectedCase.id)
        .sort((a, b) => (a.num_ranks ?? Number.MAX_SAFE_INTEGER) - (b.num_ranks ?? Number.MAX_SAFE_INTEGER));
      if (!caseRuns.length) throw new Error("No runs found for selected case");

      const runEntry =
        caseRuns.find((entry) => entry.label === requestedRun) ??
        caseRuns.find((entry) => String(entry.num_ranks) === String(requestedRun)) ??
        caseRuns[0];

      runBreadcrumb.innerHTML = `
        <a href="${baseUrl}">Case overview</a>
        &rsaquo;
        <a href="${baseUrl}instances?group=${encodeURIComponent(groupKeyForCase(selectedCase))}">
          ${selectedCase.title ? `${selectedCase.title} instances` : "Instances"}
        </a>
        &rsaquo;
        <a href="${baseUrl}figures?case=${encodeURIComponent(selectedCase.id)}#cases">Run explorer</a>
      `;

      // The run label titles the whole page now that the figures come first.
      runTitle.textContent = runEntry.label ?? "Run details";

      runMetaPanel.innerHTML = `
        <div class="table-wrap">
          <table>
            <tbody>
              ${metadataRows(runEntry, selectedCase)
                .map(([key, value]) => `<tr><th>${esc(key)}</th><td style="white-space: pre-wrap;">${esc(value)}</td></tr>`)
                .join("")}
            </tbody>
          </table>
        </div>
      `;

      const outputs = runEntry.run_outputs || {};
      const figureDefs = [
        {
          key: "durations",
          title: "Durations",
          kind: "durations",
          hasMetric: true,
          hasRegionFilter: true,
          // Prefilled; the gantt tile's filter starts empty (it shows all).
          defaultRegionFilter: true,
        },
        // Gantt shows every region unless explicitly filtered; flame always
        // shows the full call hierarchy.
        { key: "gantt", title: "Gantt", kind: "gantt", hasRegionFilter: true },
        { key: "flame", title: "Flame", kind: "flame" },
      ].filter((def) => outputs[def.key]);

      runFigures.innerHTML =
        figureDefs
          .map(
            (def) => `
              <article class="card figure-tile">
                <div class="figure-tile-header">
                  <h3 style="margin-top: 0;">${esc(def.title)}</h3>
                  ${
                    def.hasMetric
                      ? `<select id="metric-select-${def.key}" class="metric-select">
                          <option value="avg">Average</option>
                          <option value="min">Min</option>
                          <option value="max">Max</option>
                          <option value="total">Total</option>
                          <option value="first">First call</option>
                          <option value="last">Last call</option>
                        </select>`
                      : ""
                  }
                  ${
                    def.hasRegionFilter
                      ? `<input
                          id="region-filter-${def.key}"
                          class="region-filter"
                          type="search"
                          title="Comma-separated, case-insensitive substring match. Prefix a term with ^ to anchor it to the start of the region name."
                          placeholder="Filter regions, e.g. prop:, setup: total"
                          aria-label="Filter regions"
                          autocomplete="off"
                        />`
                      : ""
                  }
                </div>
                <div id="plot-${def.key}" class="plot-container"></div>
              </article>
            `,
          )
          .join("") || "<p class='muted'>No run-level figures available.</p>";

      // This page shows a single run, so its own rank count labels every bar.
      const ranksByFile = new Map(
        runEntry.num_ranks == null ? [] : [[runEntry.label, runEntry.num_ranks]],
      );

      await Promise.all(
        figureDefs.map(async (def) => {
          const container = document.getElementById(`plot-${def.key}`);
          try {
            const plotRes = await fetch(`${baseUrl}figures/${outputs[def.key]}`);
            if (!plotRes.ok) throw new Error(`HTTP ${plotRes.status}`);
            const payload = await plotRes.json();
            const select = def.hasMetric ? document.getElementById(`metric-select-${def.key}`) : null;
            const regionFilter = def.hasRegionFilter
              ? document.getElementById(`region-filter-${def.key}`)
              : null;
            if (regionFilter && def.defaultRegionFilter) regionFilter.value = DEFAULT_REGION_FILTER;
            const draw = () =>
              renderFigure(Plotly, container, def.kind, payload, {
                metric: select?.value,
                regionFilter: regionFilter?.value ?? "",
                ranksByFile: ranksByFile,
              });
            await draw();
            select?.addEventListener("change", draw);
            // Typing should feel live without re-plotting on every keystroke.
            let filterTimer = null;
            regionFilter?.addEventListener("input", () => {
              window.clearTimeout(filterTimer);
              filterTimer = window.setTimeout(draw, 200);
            });
          } catch (error) {
            container.innerHTML = `<p class="muted">Could not load ${esc(def.title)} data: ${esc(error)}</p>`;
          }
        }),
      );

      setupParameters(runEntry);
      await setupFlamegraph(runEntry);
      setupSpeedscope(runEntry);
      setupGallery(runEntry);

      const stats = runEntry.region_statistics || {};
      const commonRegions = Array.isArray(selectedCase.common_regions) ? selectedCase.common_regions : [];
      const displayRegions = commonRegions.length ? commonRegions : Object.keys(stats);
      runRegionsBody.innerHTML = displayRegions
        .map((region) => {
          const s = stats[region];
          if (!s) return "";
          return `
            <tr>
              <td>${esc(region)}</td>
              <td>${s.count ?? "-"}</td>
              <td>${fmt(s.average_duration_seconds)}</td>
              <td>${fmt(s.min_duration_seconds)}</td>
              <td>${fmt(s.max_duration_seconds)}</td>
              <td>${fmt(s.total_duration_seconds)}</td>
            </tr>
          `;
        })
        .join("");
      if (!runRegionsBody.innerHTML) {
        runRegionsBody.innerHTML = '<tr><td colspan="6">No region statistics available.</td></tr>';
      }
    } catch (error) {
      runMetaPanel.innerHTML = `<p class="muted">Could not load run metadata: ${esc(error)}</p>`;
      runFigures.innerHTML = "";
      runParametersSection.style.display = "none";
      runParametersBody.innerHTML = "";
      runGallerySection.style.display = "none";
      runGallery.innerHTML = "";
      flamegraphPanel.innerHTML = "";
      speedscopePanel.innerHTML = "";
      runRegionsBody.innerHTML = "";
    }
  };

  render();
</script>
