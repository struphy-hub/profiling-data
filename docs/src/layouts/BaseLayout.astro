---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Struphy Profiling",
  description = "Profiling runs, figures, and metadata.",
} = Astro.props as Props;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      // Default is light; dark only when explicitly chosen.
      try {
        if (localStorage.getItem("theme") === "dark") {
          document.documentElement.dataset.theme = "dark";
        }
      } catch (_) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="shell nav">
        <a href={baseUrl} class="brand">Struphy Profiling</a>
        <nav class="links">
          <a href={baseUrl}>Overview</a>
          <a href={`${baseUrl}compare`}>Compare</a>
          <a
            class="icon-link"
            href="https://github.com/struphy-hub/profiling-data"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Source repository on GitHub"
            title="Source repository on GitHub"
          >
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              />
            </svg>
          </a>
          <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-pressed="false"
            aria-label="Toggle dark mode"
          >
            <span id="theme-toggle-icon" aria-hidden="true">🌙</span>
            <span id="theme-toggle-label">Dark</span>
          </button>
        </nav>
      </div>
    </header>
    <main class="shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">Struphy profiling dashboard — generated from scope-profiler exports.</div>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.getElementById("theme-toggle");
        const icon = document.getElementById("theme-toggle-icon");
        const label = document.getElementById("theme-toggle-label");
        if (!button) return;

        const sync = () => {
          const isDark = root.dataset.theme === "dark";
          button.setAttribute("aria-pressed", isDark ? "true" : "false");
          // The button shows the action it performs, not the current state.
          if (icon) icon.textContent = isDark ? "☀︎" : "🌙";
          if (label) label.textContent = isDark ? "Light" : "Dark";
        };

        button.addEventListener("click", () => {
          const isDark = root.dataset.theme === "dark";
          if (isDark) {
            delete root.dataset.theme;
            try { localStorage.setItem("theme", "light"); } catch (_) {}
          } else {
            root.dataset.theme = "dark";
            try { localStorage.setItem("theme", "dark"); } catch (_) {}
          }
          sync();
          // Charts render once, so tell them to re-theme.
          window.dispatchEvent(new Event("themechanged"));
        });

        sync();
      })();
    </script>
    <script is:inline>
      // Makes every heading a self-link: clicking it copies a shareable URL
      // (page + query params + a #slug hash) and updates the address bar.
      // Headings are linkified as they appear, including ones injected later
      // by each page's own fetch-driven render, via MutationObserver.
      (() => {
        const HEADING_SELECTOR = "h1, h2, h3";
        const takenIds = new Set(
          Array.from(document.querySelectorAll("[id]")).map((el) => el.id),
        );

        const slugify = (text) =>
          text
            .toLowerCase()
            .trim()
            .replace(/[^a-z0-9]+/g, "-")
            .replace(/^-+|-+$/g, "") || "section";

        const uniqueId = (base) => {
          let id = base;
          let suffix = 2;
          while (takenIds.has(id)) {
            id = `${base}-${suffix}`;
            suffix += 1;
          }
          takenIds.add(id);
          return id;
        };

        const linkify = (heading) => {
          if (heading.dataset.headingLinked) return;
          heading.dataset.headingLinked = "true";

          if (heading.id) {
            takenIds.add(heading.id);
          } else {
            heading.id = uniqueId(slugify(heading.textContent || ""));
          }

          const link = document.createElement("a");
          link.className = "heading-link";
          link.href = `#${heading.id}`;
          link.setAttribute("aria-label", "Copy link to this section");
          while (heading.firstChild) link.appendChild(heading.firstChild);
          heading.appendChild(link);

          link.addEventListener("click", (event) => {
            event.preventDefault();
            const url = `${location.origin}${location.pathname}${location.search}#${heading.id}`;
            history.replaceState(null, "", `#${heading.id}`);
            heading.scrollIntoView({ block: "start", behavior: "smooth" });
            navigator.clipboard
              ?.writeText(url)
              .then(() => {
                link.classList.add("copied");
                window.setTimeout(() => link.classList.remove("copied"), 1200);
              })
              .catch(() => {});
          });

          // The target heading may not exist yet when the browser first
          // resolves the URL's fragment (it's added asynchronously by the
          // page's own render), so retry the scroll once it does.
          if (location.hash === `#${heading.id}`) {
            heading.scrollIntoView({ block: "start" });
          }
        };

        document.querySelectorAll(HEADING_SELECTOR).forEach(linkify);

        const observer = new MutationObserver((mutations) => {
          for (const mutation of mutations) {
            for (const node of mutation.addedNodes) {
              if (node.nodeType !== 1) continue;
              if (node.matches?.(HEADING_SELECTOR)) linkify(node);
              node.querySelectorAll?.(HEADING_SELECTOR).forEach(linkify);
            }
          }
        });
        observer.observe(document.body, { childList: true, subtree: true });
      })();
    </script>
  </body>
</html>
